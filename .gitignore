# Dependencies (reference copy; restorable)
node_modules/

# Stray browser-automation cache that leaked into the source dir
.tmp-chrome-cdp/

# Large binary reference / assets not needed in history
.tmp-texture-downloads/
repos/
versions/
*.zip
# ...except the sabosugi pen exports. They are 3 MB across 82 files and each holds a complete
# self-contained page that serve.py serves straight out of the archive, so without them a clone
# gets a gallery listing 101 entries that can only run 21.
!sabosugi-visuals/*.zip
research/**/*.pdf
research/stats/
# Local research scratch (downloaded repos, extracted archives, analysis notes) — not tracked
research/
__pycache__/

# Local scratch / generated traces are kept, but ignore OS cruft
.DS_Store
Thumbs.db
.__*.mjs

# Stray browser-automation logs
.tmp-*cdp*

# Brainstorming visual-companion scratch
.superpowers/

# Local TTS credential -- never commit
.eleven-key

# Panel save mirrors: one file per save click, so they would flood git status.
bot-viewer-saves/

# Baked terrain heights: ~16 MB per bake and rebuildable from the project with bake-terrain.mjs.
# The .json metadata IS tracked — it names the project and records its content hash, so a missing
# .bin is one command away rather than lost work.
terrain-bakes/*.bin

# relay-published terrain projects (content-addressed cache)
server/terrain-store/
